<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x86;x64</Platforms>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EULA.doc" Link="EULA.doc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManagedSpyLib\ManagedSpyLib.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <ProjectReference Include="..\ManagedSpyLib\ManagedSpyLib.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <ManagedSpyDirectOutputDir>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Configuration)\</ManagedSpyDirectOutputDir>
    <ManagedSpyHookProjectOutputDir>$(MSBuildThisFileDirectory)..\ManagedSpyLib\ManagedSpyLib\bin\$(Platform)\$(Configuration)\</ManagedSpyHookProjectOutputDir>
  </PropertyGroup>

  <Target
    Name="CopyManagedSpyHookArtifactsForDirectBuild"
    AfterTargets="Build"
    Condition="'$(MSBuildRuntimeType)' != 'Core' and '$(TargetDir)' == '$(ManagedSpyDirectOutputDir)' and Exists('$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.dll')">
    <ItemGroup>
      <ManagedSpyHookArtifacts Include="$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.dll" />
      <ManagedSpyHookArtifacts Include="$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.deps.json" Condition="Exists('$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.deps.json')" />
      <ManagedSpyHookArtifacts Include="$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.runtimeconfig.json" Condition="Exists('$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.runtimeconfig.json')" />
      <ManagedSpyHookArtifacts Include="$(ManagedSpyHookProjectOutputDir)Ijwhost.dll" Condition="Exists('$(ManagedSpyHookProjectOutputDir)Ijwhost.dll')" />
      <ManagedSpyHookArtifacts Include="$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.pdb" Condition="Exists('$(ManagedSpyHookProjectOutputDir)ManagedSpyHook.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(ManagedSpyHookArtifacts)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
